# Example environment variables for Create Joyful Structures
# Copy this file to `.env` and fill in the values before running the app.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional API / backend URL
VITE_API_URL=

# App environment
VITE_APP_ENV=development

# Third-party keys (example placeholders)
# VITE_MAPS_API_KEY=
# VITE_ANALYTICS_KEY=

# Notes:
# - Vite only exposes variables prefixed with `VITE_` to the client.
# - Do not commit your real secrets to version control. Use GitHub Secrets or your deployment provider's env settings for production.
